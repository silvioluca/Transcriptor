rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accesso consentito solo a questo account Google.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'silvio.phy@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid}/conversations/{cid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;

      match /segments/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000
          && request.resource.data.speaker is string
          && request.resource.data.start is number;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
